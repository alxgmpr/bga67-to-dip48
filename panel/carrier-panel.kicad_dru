	(constraint clearance (min 0.10mm))
	(condition "(A.Type == 'Pad' && A.memberOfFootprint('carrier:BGA-67_6.5x8.0mm_Layout8x10_P0.8mm_Mirrored_Interposer') && B.Type == 'Track') || (B.Type == 'Pad' && B.memberOfFootprint('carrier:BGA-67_6.5x8.0mm_Layout8x10_P0.8mm_Mirrored_Interposer') && A.Type == 'Track')"))

