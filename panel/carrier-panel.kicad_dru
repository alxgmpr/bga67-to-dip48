(version 1)

(rule "Board_0-JLC SMD pad to SMD pad 0.15mm"
	(constraint clearance (min 0.15mm))
	(condition "A.Pad_Type == 'SMD' && B.Pad_Type == 'SMD'"))

# "Via hole to Track: 0.2mm"
(rule "Board_0-JLC via hole to track 0.2mm"
	(constraint hole_clearance (min 0.2mm))
	(condition "A.Type == 'Via' && B.Type == 'Track'"))

# "PTH to Track: 0.28mm" (0.35 mm recommended)
(rule "Board_0-JLC PTH hole to track 0.28mm"
	(constraint hole_clearance (min 0.28mm))
	(condition "A.Pad_Type == 'Through-hole' && B.Type == 'Track'"))

# "NPTH to Track: 0.2mm"
(rule "Board_0-JLC NPTH hole to track 0.2mm"
	(constraint hole_clearance (min 0.2mm))
	(condition "A.Pad_Type == 'NPTH, mechanical' && B.Type == 'Track'"))

# "Inner layer via hole to copper clearance: 0.2mm"
(rule "Board_0-JLC inner-layer via hole to copper 0.2mm"
	(constraint hole_clearance (min 0.2mm))
	(condition "A.Type == 'Via' && B.Layer == 'In1.Cu'"))

(rule "Board_0-JLC inner-layer via hole to copper 0.2mm (In2)"
	(constraint hole_clearance (min 0.2mm))
	(condition "A.Type == 'Via' && B.Layer == 'In2.Cu'"))

# "Inner layer PTH pad hole to copper clearance: 0.3mm"
(rule "Board_0-JLC inner-layer PTH hole to copper 0.3mm"
	(constraint hole_clearance (min 0.3mm))
	(condition "A.Pad_Type == 'Through-hole' && B.Layer == 'In1.Cu'"))

(rule "Board_0-JLC inner-layer PTH hole to copper 0.3mm (In2)"
	(constraint hole_clearance (min 0.3mm))
	(condition "A.Pad_Type == 'Through-hole' && B.Layer == 'In2.Cu'"))

# ----------------------------------------------------------------- Drilling

# "Pad Hole-to-Hole Spacing: 0.45mm".  Plated pads only -- mouse bites are
# NPTH and JLC specifies them separately (see below), so scoping this to
# 'Through-hole' keeps a panel from tripping a rule that does not apply to it.
(rule "Board_0-JLC PTH hole to PTH hole 0.45mm"
	(constraint hole_to_hole (min 0.45mm))
	(condition "A.Pad_Type == 'Through-hole' && B.Pad_Type == 'Through-hole'"))

# "Via Hole-to-Hole Spacing: 0.2mm"
(rule "Board_0-JLC via hole to via hole 0.2mm"
	(constraint hole_to_hole (min 0.2mm))
	(condition "A.Type == 'Via' && B.Type == 'Via'"))

# "Min. Non-plated holes: 0.50mm".  Also the floor of the 0.5-0.8 mm range
# JLC recommends for mouse bites, which is why tools/panelize.sh drills 0.5.
(rule "Board_0-JLC minimum NPTH 0.5mm"
	(constraint hole_size (min 0.5mm))
	(condition "A.Pad_Type == 'NPTH, mechanical'"))

# "Mouse bites Panel: recommended distance between the two mouse-bites is
# 0.2-0.3mm."  NPTH-to-NPTH only; the 0.45 mm pad rule above does not apply.
(rule "Board_0-JLC mouse-bite hole spacing 0.2mm"
	(constraint hole_to_hole (min 0.2mm))
	(condition "A.Pad_Type == 'NPTH, mechanical' && B.Pad_Type == 'NPTH, mechanical'"))

# "PTH annular ring: multilayer 1 oz recommended 0.20mm or above, absolute
# minimum 0.15mm."  KiCad's global min_via_annular_width covers vias only.
(rule "Board_0-JLC PTH annular ring 0.15mm"
	(constraint annular_width (min 0.15mm))
	(condition "A.Pad_Type == 'Through-hole'"))

# --------------------------------------------------------------------- Cost

# Not a manufacturability limit.  "0.15mm hole size with any size via
# diameter, and 0.2mm or 0.25mm hole size with via diameter less than
# 0.45mm, will cost more."  Our vias are 0.45/0.20, exactly on the free
# boundary -- this fires if anyone shrinks a via pad below it.
(rule "Board_0-JLC via below the free-tooling boundary (cost, not a defect)"
	(severity warning)
	(constraint via_diameter (min 0.45mm))
	(condition "A.Type == 'Via'"))
(rule "Board_1-JLC SMD pad to SMD pad 0.15mm"
	(constraint clearance (min 0.15mm))
	(condition "A.Pad_Type == 'SMD' && B.Pad_Type == 'SMD'"))

