	(constraint clearance (min 0.10mm))
	(condition "(A.Type == 'Pad' && A.memberOfFootprint('carrier:BGA-67_6.5x8.0mm_Layout8x10_P0.8mm_Mirrored_Interposer') && B.Type == 'Track') || (B.Type == 'Pad' && B.memberOfFootprint('carrier:BGA-67_6.5x8.0mm_Layout8x10_P0.8mm_Mirrored_Interposer') && A.Type == 'Track')"))

# JLC warns that both the BGA pad and via may be cut back below this spacing.
# This is a physical manufacturing constraint, so it must also check same-net
# dogbone vias; ordinary electrical clearance would silently skip them.
(rule "Board_22-JLC BGA pad to via copper 0.10mm"
	(constraint physical_clearance (min 0.10mm))
	(condition "(A.Type == 'Pad' && A.memberOfFootprint('carrier:BGA-67_6.5x8.0mm_Layout8x10_P0.8mm_Mirrored_Interposer') && B.Type == 'Via') || (B.Type == 'Pad' && B.memberOfFootprint('carrier:BGA-67_6.5x8.0mm_Layout8x10_P0.8mm_Mirrored_Interposer') && A.Type == 'Via')"))

